#version 450
// Z3: the centre of every face of a two-cube array
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform samplerCubeArray t;
layout(set = 0, binding = 1) buffer O { uint o[]; };
void main()
{
	const vec3 d[6] = vec3[6](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0),
				  vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));
	for (int k = 0; k < 12; k++)
		o[k] = packUnorm4x8(textureLod(t, vec4(d[k % 6], float(k / 6)), 0.0));
}

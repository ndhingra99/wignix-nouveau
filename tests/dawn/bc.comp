#version 450
// Z1: every texel of an 8x8 compressed image, as floats
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D t;
layout(set = 0, binding = 1) buffer O { vec4 o[]; };
void main()
{
	ivec2 p = ivec2(gl_LocalInvocationID.xy);
	o[p.y * 8 + p.x] = texelFetch(t, p, 0);
}

#version 450
// Z2: 32 invocations read and write 16-word bindings (robustBufferAccess)
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly buffer I { uint v[]; } inb;
layout(set = 0, binding = 1) writeonly buffer W { uint v[]; } outb;
layout(set = 0, binding = 2) uniform U { uvec4 v[8]; } ub;
layout(set = 0, binding = 3) buffer R { uint r[]; } res;
layout(push_constant) uniform PC { uint zero; } pc;
void main()
{
	uint i = gl_LocalInvocationID.x;
	uint idx = i + pc.zero;
	res.r[i] = inb.v[idx];
	outb.v[idx] = 500u + i;
	res.r[32u + i] = ub.v[idx >> 2][idx & 3u];
}

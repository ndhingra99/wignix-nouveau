#version 450
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0, rgba16f) uniform image3D img;
layout(std430, set = 0, binding = 1) buffer B { uvec4 v[]; };
void main()
{
	ivec3 p = ivec3(gl_GlobalInvocationID);
	vec4 val = imageLoad(img, p);
	v[p.x + 20 * (p.y + 12 * p.z)] = floatBitsToUint(val);
}
